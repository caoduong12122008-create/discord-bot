# Discord Bot Token
TOKEN=your_bot_token_here

# Server ID (Guild ID)
GUILD_ID=your_guild_id_here

# Admin Role ID
ADMIN_ROLE_ID=your_admin_role_id_here

# Ticket Category ID
TICKET_CATEGORY_ID=your_ticket_category_id_here

# QR Code Image URL
QR_CODE_URL=your_qr_code_image_url_here

# MongoDB URI (để host bot, bắt buộc)
# Lấy từ: https://www.mongodb.com/cloud/atlas (free tier)
MONGO_URI=
# Database Type (json hoặc mongodb)
# json = local file (phát triển)
# mongodb = cloud database (host)
DB_TYPE=json
